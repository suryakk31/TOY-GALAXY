<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wishlist</title>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/user/wishlist.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <%- include('../partials/header') %>

    <div class="main-container">
      <%- include('../partials/sidebar', { currentPath: currentPath }) %>
        
        <div class="content-area">
            <div class="wishlist-container">
                <% if (wishlistItems && wishlistItems.length > 0) { %>
                    <% wishlistItems.forEach(product => { %>
                        <div class="wishlist-item" data-product-id="<%= product._id %>">
                            <a href="/auth/product/<%= product._id %>">
                                <% if (product.image && product.image.length > 0) { %>
                                    <img src="<%= product.image[0] %>" alt="<%= product.name %>">
                                <% } else { %>
                                    <div class="no-image">No Image</div>
                                <% } %>
                            </a>
                            <div class="wishlist-details">
                                <h2><a href="/auth/product/<%= product._id %>"><%= product.name %></a></h2>
                                
                                <p><strong>Price:</strong> ₹<%= product.price.toFixed(2) %> 
                                    <span class="discount">(<%= product.discount %>% off)</span>
                                </p>
                                
                                <p><strong>Description:</strong> <%= product.description %></p>
                                
                                <div class="wishlist-actions">
                                    <form action="/auth/cart" method="POST" class="d-inline">
                                        <input type="hidden" name="productId" value="<%= product._id %>" />
                                        <button 
                                            class="btn btn-primary" 
                                            type="submit"
                                            <% if (product.stock <= 0) { %> 
                                                disabled
                                            <% } %>
                                        >
                                            Add to Cart
                                        </button>
                                    </form>
                                    
                                    <button 
                                        class="btn btn-danger remove-from-wishlist" 
                                        data-product-id="<%= product._id %>"
                                    >
                                        Remove
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }); %>

                    <% if (totalPages > 1) { %>
                        <div class="pagination">
                            <% if (currentPage > 1) { %>
                                <a href="?page=<%= currentPage - 1 %>">Previous</a>
                            <% } %>

                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <a href="?page=<%= i %>" class="<%= i === currentPage ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                            <% } %>

                            <% if (currentPage < totalPages) { %>
                                <a href="?page=<%= currentPage + 1 %>">Next</a>
                            <% } %>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="no-wishlist">
                        <i class='bx bx-heart-circle' style="font-size: 48px; display: block; margin-bottom: 10px;"></i>
                        <p>Your wishlist is empty.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.remove-from-wishlist').forEach(button => {
        button.addEventListener('click', async function(e) {
          e.preventDefault();
          const productId = this.dataset.productId;
          try {
            const response = await fetch('/auth/wishlist/remove', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ productId }),
            });
            const data = await response.json();
            if (data.removed) {
              const wishlistCard = this.closest('.wishlist-card');
              wishlistCard.remove();
              
           
              const wishlistContainer = document.querySelector('.wishlist-container');
              if (wishlistContainer.children.length === 0) {
                const emptyMessage = document.createElement('p');
                emptyMessage.className = 'empty-wishlist';
                emptyMessage.textContent = 'Your wishlist is empty.';
                wishlistContainer.appendChild(emptyMessage);
              }
  
         
              Swal.fire({
                title: 'Removed!',
                text: 'Item removed from wishlist',
                icon: 'success',
                timer: 1500
              });
            } else {
              throw new Error('Failed to remove item from wishlist');
            }
          } catch (error) {
            console.error('Error removing from wishlist:', error);
         
            Swal.fire({
              title: 'Error!',
              text: 'Failed to remove item from wishlist',
              icon: 'error',
            });
          }
        });
      });
    });
  </script>
</body>
</html>