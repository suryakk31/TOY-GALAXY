<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Coupons</title>
  <link rel="stylesheet" href="/css/user/coupon.css">
  <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/header') %>
  
  <div class="main-container">
    <%- include('../partials/sidebar', { currentPath: currentPath }) %>
    
    <div class="content-area">
      <div class="profile-content">
        <h2>My Coupons</h2>
        
        <div class="coupon-container">
          <% coupon.forEach(coupon => { %>
            <div class="coupon-card">
              <div>
                <h3><%= coupon.description %></h3>
                <h5>Offer: <%= coupon.discount %> %</h5>
              </div>
              
              <div class="coupon-row">
                <span id="cpnCode" class="coupon-code"><%= coupon.couponCode %></span>
                <button class="cpnBtn copy-btn">COPY CODE</button>
              </div>
              
              <div class="coupon-details">
                <h5>Min amount: ₹ <%= coupon.minAmount %> to get this offer</h5>
                <h5>Max amount: This offer is valid for orders upto ₹ <%= coupon.maxAmount %></h5>
                <p>Valid Till: <%= new Date(coupon.expiryDate).toLocaleDateString() %></p>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script>
   

    document.addEventListener('DOMContentLoaded', function() {
  let cpnBtn = document.querySelectorAll('.cpnBtn');
  cpnBtn.forEach(btn => {
    btn.addEventListener('click', function() {
      let cpnCode = this.previousElementSibling;
      console.log("Coupon Code:", cpnCode.innerHTML); 
      navigator.clipboard.writeText(cpnCode.innerHTML)
        .then(() => {
          this.innerHTML = 'COPIED';
          setTimeout(() => {
            btn.innerHTML = 'COPY CODE';
          }, 3000);
        })
        .catch(err => {
          console.error("Failed to copy: ", err);
        });
    });
  });
});


  </script>

</body>
</html>
