

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Cart</title>
  <link rel="stylesheet" href="/css/user/cart.css">

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

 
  
</head>
<body>


  <%- include('../partials/header') %>
 

 

<section class="h-100 gradient-custom">
  <div class="container py-7">
    <div class="row d-flex justify-content-center my-4">
      <div class="col-md-8">
        <div class="card mb-4">
          <div class="card-header py-3">
            <h5 class="mb-0">My Cart</h5>
          </div>
          <div class="card-body">
            
            <% if (!isLoggedIn) { %>
              <div class="empty-cart">
                <p>Please log in to view your cart.</p>
                <a href="/auth/login" class="btn btn-primary">Shop Now</a>
              </div>
            <% } else if (cart.items && cart.items.length > 0) { %>
              <% cart.items.forEach(item => { %>
                <div class="row mb-4">
                  <div class="col-lg-3 col-md-12 mb-4 mb-lg-0">
                    <div class="bg-image hover-overlay hover-zoom ripple rounded">
                      <img src="<%= item.productId.image[0] %>" class="w-100" alt="Product Image" />
                    </div>
                  </div>
                  <div class="col-lg-5 col-md-6 mb-4 mb-lg-0">
                    <p><strong><%= item.productId.name %></strong></p>
                    <p>Category: <%= item.productId.category.name %></p>
                    <p>Description: <%= item.productId.description %></p>
                    <button type="button" class="btn btn-primary btn-sm me-1 mb-2 remove-btn" data-product-id="<%= item.productId._id %>" data-mdb-tooltip-init title="Remove item" >
                      <i class="fas fa-trash"></i>
                    </button>
                  
                  </div>
                  <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                    <div class="d-flex mb-4" style="max-width: 300px">
                      <button class=" px-3 me-2 quantity-btn" data-product-id="<%= item.productId._id %>" data-change="-1" <%= item.quantity === 1 ? 'disabled' : '' %>>
                        <i class="fas fa-minus"></i>
                      </button>
                      <input id="form1" min="1" name="quantity" value="<%= item.quantity %>" type="number" class="form-control text-center" readonly />
                      <button class="px-3 ms-2 quantity-btn" data-product-id="<%= item.productId._id %>" data-change="1">
                        <i class="fas fa-plus"></i>
                      </button>
                    </div>
                    <p class="text-start text-md-center">
                      <strong>₹<%= (item.productId.price - (item.productId.price * item.productId.discount / 100)).toFixed(2) %></strong>
                    </p>
                  </div>
                </div>
                <hr class="my-4" />
              <% }) %>
            <% } else { %>
              <div class="empty-cart">
                <p>Your cart is empty.</p>
                <a href="/auth/shop" class="btn btn-primary">Shop Now</a>
              </div>
            <% } %>
          </div>
        </div>

        <% if (cart.items && cart.items.length > 0) { %>
          
          <div class="card mb-4 mb-lg-0">
            <div class="card-body">
              <p><strong>We accept</strong></p>
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <img class="me-2" width="70px" src="https://mdbcdn.b-cdn.net/wp-content/plugins/woocommerce-gateway-stripe/assets/images/visa.svg" alt="Visa" />
                  <img class="me-2" width="70px" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS82g8mkrlMMiQ17FGj5_VQAQ-P2gHUyXhYIQ&s" alt="Rupay" />
                  <img class="me-2" width="70px" src="https://www.cardexpert.in/wp-content/uploads/2020/06/onecard-credit-card.jpg" alt="One card" />
                  
                  <img class="me-2" width="70px" src="https://mdbcdn.b-cdn.net/wp-content/plugins/woocommerce-gateway-stripe/assets/images/mastercard.svg" alt="Mastercard" />
                  <img class="me-2" width="70px" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRugu--LkxJz7vatGEphcyncDsm1rFyGc30pA&s" alt="cash on delivery" />
                </div>
                <div>
                  <a href="/auth/shop" class=" btn-lg btn-block">Continue Shopping</a>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>

      <% if (cart.items && cart.items.length > 0) { %>
        <div class="col-md-4">
          <div class="card mb-4">
            <div class="card-header py-3">
              <h5 class="mb-0">Summary</h5>
            </div>
            <div class="card-body">
              <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0">
                  Price
                  <span>₹<%= cart.originalTotal %></span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0">
                  category offer
                  <span>₹<%= cart.categoryOffer %></span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                  Shipping
                   <span><%= cart.deliveryFeeDisplay %></span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 mb-3">
                  <div>
                    <strong>Total amount</strong>
                  </div>
                  <span><strong>₹<%= cart.total %></strong></span>
                </li>
              </ul>
              <div class="d-flex justify-content-center">
                <button id="goToCheckoutButton" class="btn-primary" onclick="window.location.href='/auth/checkout'">Go to Checkout</button>


              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  
</section>

<div class="footer">
  <p>&copy; <%= new Date().getFullYear() %>  kids kastle</p>
</div>





  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>

  <script>
document.querySelectorAll('.quantity-btn').forEach(button => {
  button.addEventListener('click', function() {
    const productId = this.getAttribute('data-product-id');
    const change = parseInt(this.getAttribute('data-change'));
    const quantityInput = this.parentElement.querySelector('input[name="quantity"]');
    const priceElement = this.closest('.row').querySelector('strong');
    const summaryElements = {
      originalTotal: document.querySelector('.list-group-item:nth-child(1) span'),
      categoryOffer: document.querySelector('.list-group-item:nth-child(2) span'),
      shipping: document.querySelector('.list-group-item:nth-child(3) span'),
      total: document.querySelector('.list-group-item:nth-child(4) span strong')
    };

    updateQuantity(productId, change, quantityInput, priceElement, summaryElements);
  });
});

document.querySelectorAll('.remove-btn').forEach(button => {
  button.addEventListener('click', function() {
    const productId = this.getAttribute('data-product-id');
    removeItemFromCart(productId);
  });
});

function updateQuantity(productId, change, quantityInput, priceElement, summaryElements) {
  fetch('/auth/cart', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ productId, change })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Update quantity input
      quantityInput.value = data.item.quantity;
      
      // Update item price
      const itemPrice = (data.item.productId.price - (data.item.productId.price * data.item.productId.discount / 100)).toFixed(2);
      priceElement.textContent = `₹${itemPrice}`;
      
      // Update summary section
      summaryElements.originalTotal.textContent = `₹${data.cart.originalTotal}`;
      summaryElements.categoryOffer.textContent = `₹${data.cart.categoryOffer}`;
      summaryElements.shipping.textContent = data.cart.deliveryFeeDisplay;
      summaryElements.total.textContent = `₹${data.cart.total}`;
      
      // Update minus button state based on quantity
      const minusButton = quantityInput.parentElement.querySelector('[data-change="-1"]');
      minusButton.disabled = data.item.quantity === 1;

    } else if (data.message === 'out_of_stock') {
      Swal.fire({
        icon: 'error',
        title: 'Out of Stock',
        text: 'Sorry, this product is currently out of stock.',
        confirmButtonColor: '#9D51FF'
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Out of Stock',
        text: 'Sorry, this product is currently out of stock.',
        confirmButtonColor: '#9D51FF'
      });
    }
  })
  .catch(error => {
    console.error('Error:', error);
    Swal.fire({
      icon: 'error',
      title: 'Error',
      text: 'An error occurred while updating the quantity.',
      confirmButtonColor: '#9D51FF'
    });
  });
}


    document.querySelectorAll('.remove-btn').forEach(button => {
    button.addEventListener('click', function() {
      const productId = this.getAttribute('data-product-id');


      Swal.fire({
        title: 'Are you sure?',
        text: "You want to remove the product from the cart",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, remove it!',
        cancelButtonText: 'Cancel'
      }).then((result) => {
        if (result.isConfirmed) {
        
          removeProduct(productId);
        }
      });
    });
  });
// Update the removeProduct function in your frontend JavaScript
function removeProduct(productId) {
  fetch('/auth/cart', {
    method: 'DELETE',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ productId })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Remove the product row from the DOM
      const productRow = document.querySelector(`[data-product-id="${productId}"]`).closest('.row');
      productRow.remove();
      
      // Update the cart summary
      updateCartSummary(data.cart);
      
      // Show success message
      Swal.fire({
        icon: 'success',
        title: 'Removed!',
        text: 'The product has been removed from your cart.',
        timer: 2000,
        timerProgressBar: true,
        showConfirmButton: false
      });
      
      // Check if cart is empty after removal
      const remainingItems = document.querySelectorAll('.card-body .row').length;
      if (remainingItems === 0) {
        // Replace cart content with empty cart message
        const cardBody = document.querySelector('.card-body');
        cardBody.innerHTML = `
          <div class="empty-cart">
            <p>Your cart is empty.</p>
            <a href="/auth/shop" class="btn btn-primary">Shop Now</a>
          </div>
        `;
        
        // Remove the summary section and payment methods section
        const summarySection = document.querySelector('.col-md-4');
        const paymentSection = document.querySelector('.card.mb-4.mb-lg-0');
        if (summarySection) summarySection.remove();
        if (paymentSection) paymentSection.remove();
      }
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Error!',
        text: data.message || 'Failed to remove product.',
        confirmButtonColor: '#9D51FF'
      });
    }
  })
  .catch(error => {
    console.error('Error:', error);
    Swal.fire({
      icon: 'error',
      title: 'Error!',
      text: 'An error occurred while removing the product.',
      confirmButtonColor: '#9D51FF'
    });
  });
}

function updateCartSummary(cartData) {
  if (!cartData) return;
  
  const summaryElements = {
    originalTotal: document.querySelector('.list-group-item:nth-child(1) span'),
    categoryOffer: document.querySelector('.list-group-item:nth-child(2) span'),
    shipping: document.querySelector('.list-group-item:nth-child(3) span'),
    total: document.querySelector('.list-group-item:nth-child(4) span strong')
  };
  
  if (summaryElements.originalTotal) {
    summaryElements.originalTotal.textContent = `₹${cartData.originalTotal}`;
  }
  if (summaryElements.categoryOffer) {
    summaryElements.categoryOffer.textContent = `₹${cartData.categoryOffer}`;
  }
  if (summaryElements.shipping) {
    summaryElements.shipping.textContent = cartData.deliveryFeeDisplay;
  }
  if (summaryElements.total) {
    summaryElements.total.textContent = `₹${cartData.total}`;
  }
}


  </script>
</body>
</html>
