<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FunZone - Toy Galaxy</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <style>
        /* FunZone Styles */
:root {
    --primary-color: #8A2BE2;
    --secondary-color: #FFD700;
    --accent-color: #FF6B6B;
    --background-light: #F8F9FA;
    --text-dark: #2D3436;
    --text-light: #FFFFFF;
}

/* Hero Section */
.funzone-hero {
    background: linear-gradient(135deg, var(--primary-color), #6A5ACD);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.hero-content {
    text-align: center;
    color: var(--text-light);
    z-index: 2;
}

.hero-content h1 {
    font-size: 4rem;
    margin-bottom: 1rem;
    animation: bounceIn 1s ease;
}

.floating-toys {
    position: absolute;
    width: 100%;
    height: 100%;
}

.toy {
    position: absolute;
    font-size: 3rem;
    animation: float 6s ease-in-out infinite;
}

.toy1 { top: 20%; left: 20%; animation-delay: 0s; }
.toy2 { top: 30%; right: 20%; animation-delay: 1s; }
.toy3 { bottom: 20%; left: 30%; animation-delay: 2s; }
.toy4 { bottom: 30%; right: 30%; animation-delay: 3s; }

@keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(10deg); }
}

/* Activity Categories */
.activity-categories {
    padding: 4rem 2rem;
    background-color: var(--background-light);
}

.category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.category-card {
    background: white;
    padding: 2rem;
    border-radius: 15px;
    text-align: center;
    transition: transform 0.3s ease;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.category-card:hover {
    transform: translateY(-10px);
}

.category-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
}

/* Featured Blogs */
.featured-blogs {
    padding: 4rem 2rem;
}

.blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.blog-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
}

.blog-card:hover {
    transform: translateY(-5px);
}

.blog-image {
    position: relative;
    height: 200px;
}

.blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.category-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--primary-color);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
}

.blog-content {
    padding: 1.5rem;
}

.blog-meta {
    color: #666;
    font-size: 0.9rem;
    margin: 0.5rem 0;
}

.read-more {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: bold;
}

/* Interactive Activities */
.interactive-section {
    padding: 4rem 2rem;
    background: linear-gradient(135deg, #F6F8FF, #F0F3FF);
}

.activities-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.activity-box {
    background: white;
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.activity-content {
    text-align: center;
    margin-top: 1rem;
}

.download-btn, .join-challenge-btn {
    background: var(--primary-color);
    color: white;
    padding: 0.8rem 1.5rem;
    border: none;
    border-radius: 25px;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.download-btn:hover, .join-challenge-btn:hover {
    transform: scale(1.05);
}

.quiz-options button {
    display: block;
    width: 100%;
    padding: 0.8rem;
    margin: 0.5rem 0;
    border: 2px solid var(--primary-color);
    border-radius: 25px;
    background: transparent;
    cursor: pointer;
    transition: all 0.3s ease;
}

.quiz-options button:hover {
    background: var(--primary-color);
    color: white;
}

/* Community Showcase */
.community-showcase {
    padding: 4rem 2rem;
}

.showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
}

.showcase-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.showcase-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.showcase-info {
    padding: 1rem;
}

.showcase-stats {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: #666;
}

.load-more-btn {
    display: block;
    margin: 2rem auto 0;
    padding: 1rem 2rem;
    background: var(--secondary-color);
    border: none;
    border-radius: 25px;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.load-more-btn:hover {
    transform: scale(1.05);
}

/* Newsletter Section */
.newsletter-section {
    background: linear-gradient(135deg, var(--primary-color), #6A5ACD);
    padding: 4rem 2rem;
    text-align: center;
    color: white;
}

.newsletter-form {
    display: flex;
    gap: 1rem;
    max-width: 500px;
    margin: 2rem auto 0;
}

.newsletter-form input {
    flex: 1;
    padding: 1rem;
    border: none;
    border-radius: 25px;
    outline: none;
}

.newsletter-form button {
    padding: 1rem 2rem;
    background: var(--secondary-color);
    border: none;
    border-radius: 25px;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.newsletter-form button:hover {
    transform: scale(1.05);
}

/* Responsive Adjustments Continued */
@media (max-width: 768px) {
    .hero-content h1 {
        font-size: 2.5rem;
    }

    .hero-content p {
        font-size: 1rem;
    }

    .toy {
        font-size: 2rem;
    }

    .category-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .blog-grid {
        grid-template-columns: 1fr;
    }

    .activities-container {
        grid-template-columns: 1fr;
    }

    .newsletter-form {
        flex-direction: column;
        padding: 0 1rem;
    }

    .newsletter-form button {
        width: 100%;
    }
}

@media (max-width: 480px) {
    .hero-content h1 {
        font-size: 2rem;
    }

    .category-grid {
        grid-template-columns: 1fr;
    }

    .showcase-grid {
        grid-template-columns: 1fr;
    }

    .category-card {
        padding: 1.5rem;
    }
}

/* Animations */
@keyframes bounceIn {
    0% {
        transform: scale(0.3);
        opacity: 0;
    }
    50% {
        transform: scale(1.05);
        opacity: 0.8;
    }
    70% {
        transform: scale(0.9);
        opacity: 0.9;
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Interactive Elements */
.activity-box {
    position: relative;
    overflow: hidden;
}

.activity-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
}

.challenge-timer {
    background: #FFE5E5;
    color: var(--accent-color);
    padding: 0.5rem;
    border-radius: 10px;
    margin: 1rem 0;
    font-weight: bold;
}

/* Enhanced Hover Effects */
.blog-card .blog-image::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.5));
    transition: opacity 0.3s ease;
    opacity: 0;
}

.blog-card:hover .blog-image::after {
    opacity: 1;
}

.category-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, transparent 30%, rgba(138,43,226,0.1));
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.category-card:hover::before {
    opacity: 1;
}

/* Loading States */
.loading-shine {
    position: relative;
    overflow: hidden;
}

.loading-shine::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,0.3),
        transparent
    );
    animation: shine 1.5s infinite;
}

@keyframes shine {
    to {
        left: 100%;
    }
}

/* Interactive Quiz Styles */
.quiz-options button.correct {
    background: #4CAF50;
    color: white;
    border-color: #4CAF50;
}

.quiz-options button.wrong {
    background: #FF5252;
    color: white;
    border-color: #FF5252;
}

/* Community Showcase Enhancements */
.showcase-card {
    position: relative;
    transition: all 0.3s ease;
}

.showcase-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, var(--primary-color), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.showcase-card:hover::before {
    opacity: 0.2;
}

.showcase-stats span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

/* Newsletter Form Enhancements */
.newsletter-form input:focus {
    box-shadow: 0 0 0 3px rgba(138,43,226,0.3);
}

.newsletter-form button {
    position: relative;
    overflow: hidden;
}

.newsletter-form button::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5px;
    height: 5px;
    background: rgba(255,255,255,0.5);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
}

.newsletter-form button:active::after {
    animation: ripple 0.8s ease-out;
}

@keyframes ripple {
    0% {
        width: 0;
        height: 0;
        opacity: 0.5;
    }
    100% {
        width: 200px;
        height: 200px;
        opacity: 0;
    }
}

/* Accessibility Enhancements */
@media (prefers-reduced-motion: reduce) {
    .toy,
    .category-card,
    .blog-card,
    .newsletter-form button {
        transition: none;
        animation: none;
    }
}

/* Focus States */
button:focus-visible,
a:focus-visible,
input:focus-visible {
    outline: 3px solid var(--primary-color);
    outline-offset: 2px;
}

/* Print Styles */
@media print {
    .funzone-hero,
    .newsletter-section,
    .interactive-section {
        display: none;
    }

    .blog-card,
    .category-card {
        break-inside: avoid;
        page-break-inside: avoid;
    }
}
    </style>
</head>
<body>

    <%- include('../partials/header') %>


    <!-- Hero Section -->
    <section class="funzone-hero">
        <div class="hero-content">
            <h1>Welcome to the Fun Zone!</h1>
            <p>Discover amazing toy stories, crafts, and activities</p>
            <div class="floating-toys">
                <div class="toy toy1">🚀</div>
                <div class="toy toy2">🎮</div>
                <div class="toy toy3">🧸</div>
                <div class="toy toy4">🎨</div>
            </div>
        </div>
    </section>

    <!-- Activity Categories -->
    <section class="activity-categories">
        <h2>Fun Activities</h2>
        <div class="category-grid">
            <div class="category-card craft">
                <div class="category-icon">🎨</div>
                <h3>DIY Crafts</h3>
                <p>Create amazing toys from household items</p>
            </div>
            <div class="category-card games">
                <div class="category-icon">🎲</div>
                <h3>Indoor Games</h3>
                <p>Fun games to play at home</p>
            </div>
            <div class="category-card learning">
                <div class="category-icon">📚</div>
                <h3>Educational Fun</h3>
                <p>Learn while you play</p>
            </div>
            <div class="category-card outdoor">
                <div class="category-icon">⚽</div>
                <h3>Outdoor Adventures</h3>
                <p>Exciting outdoor activities</p>
            </div>
        </div>
    </section>

    <!-- Featured Blogs -->
    <section class="featured-blogs">
        <h2>Toy Stories & Blogs</h2>
        <div class="blog-grid">
            <article class="blog-card">
                <div class="blog-image">
                    <div class="category-tag">DIY Crafts</div>
                    <img src="/image/robo.jpg" alt="Make Your Own Robot">
                </div>
                <div class="blog-content">
                    <h3>Create Your Own Robot Friend</h3>
                    <p class="blog-meta">By Sarah Crafts | 10 min read</p>
                    <p>Learn how to make an awesome robot using cardboard boxes and simple household items!</p>
                    <a href="#" class="read-more">Read More →</a>
                </div>
            </article>

            <article class="blog-card">
                <div class="blog-image">
                    <div class="category-tag">Toy History</div>
                    <img src="/image/leogo.jpg" alt="LEGO History">
                </div>
                <div class="blog-content">
                    <h3>The Amazing History of LEGO</h3>
                    <p class="blog-meta">By Tom Builder | 8 min read</p>
                    <p>Discover how a small carpenter's workshop became the world's biggest toy company.</p>
                    <a href="#" class="read-more">Read More →</a>
                </div>
            </article>

            <article class="blog-card">
                <div class="blog-image">
                    <div class="category-tag">Play Tips</div>
                    <img src="/image/leogo 400 .jpg" alt="Creative Play">
                </div>
                <div class="blog-content">
                    <h3>10 Creative Ways to Play with Blocks</h3>
                    <p class="blog-meta">By Play Expert Amy | 12 min read</p>
                    <p>Transform simple building blocks into endless adventures!</p>
                    <a href="#" class="read-more">Read More →</a>
                </div>
            </article>
        </div>
    </section>

    <!-- Interactive Activities -->
    <section class="interactive-section">
        <h2>Today's Fun Activities</h2>
        

            <div class="activity-box daily-challenge">
                <h3>🎯 Daily Challenge</h3>
                <div class="activity-content">
                    <h4>Build a Toy Castle</h4>
                    <p>Using items from around your house, create a magical castle!</p>
                    <div class="challenge-timer">Time Left: 23:45:12</div>
                    <button class="join-challenge-btn">Join Challenge</button>
                </div>
            </div>

            <hr>

            <div class="activity-box toy-quiz">
                <h3>🤔 Toy Trivia</h3>
                <div class="activity-content">
                    <h4>Question of the Day</h4>
                    <p>Which toy was first inducted into the Toy Hall of Fame?</p>
                    <div class="quiz-options">
                        <button>LEGO</button>
                        <button>Barbie</button>
                        <button>Teddy Bear</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Community Showcase -->
    <section class="community-showcase">
        <h2>Community Creations</h2>
        <div class="showcase-grid">
            <!-- Community posts will be dynamically loaded here -->
            <div class="showcase-card">
                <img src="/image/comm.jpg" alt="Community Creation">
                <div class="showcase-info">
                    <h4>Dragon Castle</h4>
                    <p>By: Little Builder Jack</p>
                    <div class="showcase-stats">
                        <span>❤️ 245</span>
                        <span>💬 23</span>
                    </div>
                </div>
            </div>
            <!-- More showcase cards -->
        </div>
        <button class="load-more-btn">Load More Creations</button>
    </section>

    <!-- Newsletter Signup -->
    <section class="newsletter-section">
        <div class="newsletter-content">
            <h2>Join the Fun Club!</h2>
            <p>Get weekly craft ideas, toy stories, and exclusive activities!</p>
            <form class="newsletter-form">
                <input type="email" placeholder="Enter your email">
                <button type="submit">Join the Fun!</button>
            </form>
        </div>
    </section>


    <%- include('../partials/footer') %>
</body>
</html>