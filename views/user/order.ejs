<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders</title>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/user/order.css">
</head>
<body>
    <%- include('../partials/header') %>

    <div class="main-container">
      <%- include('../partials/sidebar', { currentPath: currentPath }) %>
        
        <div class="content-area">
            <div class="orders-container">
                <% if (orders && orders.length > 0) { %>
                    <% orders.forEach(order => { %>
                        <% order.items.forEach(item => { %>
                            <div class="order-item" data-order-id="<%= order._id %>">
                                <img src="<%= item.productImage[0] %>" alt="<%= item.productName %>">
                                <div class="order-details">
                                    <h2><%= item.productName %></h2>
                                   
                                    <p><strong>Quantity:</strong> <%= item.quantity %></p>
                                    <p><strong>Total Price:</strong> ₹<%= order.totalPrice.toFixed(2) %></p>
                                    <p><strong>Order Date:</strong> <%= new Date(order.createdAt).toLocaleDateString() %></p>
                                </div>
                            </div>
                        <% }) %>
                    <% }) %>

                    <% if (totalPages > 1) { %>
                        <div class="pagination">
                            <% if (currentPage > 1) { %>
                                <a href="?page=<%= currentPage - 1 %>">Previous</a>
                            <% } %>

                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <a href="?page=<%= i %>" class="<%= i === currentPage ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                            <% } %>

                            <% if (currentPage < totalPages) { %>
                                <a href="?page=<%= currentPage + 1 %>">Next</a>
                            <% } %>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="no-orders">
                        <i class='bx bx-package' style="font-size: 48px; display: block; margin-bottom: 10px;"></i>
                        <p>No orders found.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script>
        document.querySelectorAll('.order-item').forEach(item => {
            item.addEventListener('click', function() {
                const orderId = this.getAttribute('data-order-id');
                window.location.href = `/auth/orderDetails/${orderId}`;
            });
        });
    </script>
</body>
</html>