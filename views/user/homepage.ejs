<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Toy Galaxy </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/user/homePage.css">
  <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    /* Custom SweetAlert styles */
    .swal2-popup {
        border-radius: 15px;
        font-family: Arial, sans-serif;
    }
    
    .swal2-title {
        color: #4a4a4a;
        font-size: 1.8em;
    }
    
    .swal2-html-container {
        color: #666;
    }
    
    .swal2-confirm {
        background-color: #ff6b6b !important;
        border-radius: 5px !important;
        padding: 12px 30px !important;
    }
    
    .swal2-confirm:focus {
        box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.3) !important;
    }
    
    /* Loading spinner customization */
    .swal2-loading {
        border-color: #ff6b6b transparent #ff6b6b transparent;
    }
    
    /* Success icon customization */
    .swal2-success-ring {
        border-color: #4CAF50;
    }
    
    .swal2-success-line-tip,
    .swal2-success-line-long {
        background-color: #4CAF50;
    }
    
    /* Error icon customization */
    .swal2-error {
        border-color: #d33;
    }
    
    .swal2-x-mark-line-left,
    .swal2-x-mark-line-right {
        background-color: #d33;
    }
    </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container-fluid px-0">
    <section class="banner-container">
      <div class="banner">
        <img src="/image/Hot_Wheels-170524_1170x.jpeg" alt="Kids Kastle Featured Collection" >
        <img src="/image/Play_Hour-170524_1270x.jpeg" alt="Kids Kastle Featured Collection" >
        <img src="/image/Nerf-170524_1170x.jpeg" alt="Kids Kastle Featured Collection" >
        <img src="/image/Barbie170524_1170x.jpeg" alt="Kids Kastle Featured Collection" >
        <img src="/image/Lego-170524_1170x.jpeg" alt="Kids Kastle Featured Collection" >
      </div>
    </section>

    <!-- New Arrivals Section -->
    <section class="container">
      <div class="new-arrivals">
        <h1>NEW ARRIVALS</h1>
      </div>
   
      <div class="products-grid">
        <% products.forEach(product => { 
          const discountedPrice = product.price - (product.price * product.discount / 100);
        %>
          <article class="product-card">
            <div class="product-image">
              <a href="/auth/product/<%= product._id %>">
                <% if (product.image && product.image.length > 0) { %>
                  <img src="<%= product.image[0] %>" alt="<%= product.name %>" loading="lazy">
                <% } else { %>
                  <div class="no-image">No Image</div>
                <% } %>
              </a>
            </div>
            
            <div class="product-info">
              <h2 class="product-title">
                <a href="/auth/product/<%= product._id %>"><%= product.name %></a>
              </h2>
              
              <div class="product-price">
                <span class="original-price">₹<%= product.price.toFixed(2) %></span>
                <span class="discounted-price">₹<%= discountedPrice.toFixed(2) %></span>
 
              </div>
              
            
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    <!-- Top Offers Section -->
    <section class="container mt-5">
      <div class="top-offers">
        <h1>TOP OFFERS</h1>
      </div>
   
      <div class="products-grid">
        <% topOfferProducts.forEach(product => { 
          const discountedPrice = product.price - (product.price * product.discount / 100);
        %>
          <article class="product-card">
            <div class="product-image">
              <a href="/auth/product/<%= product._id %>">
                <% if (product.image && product.image.length > 0) { %>
                  <img src="<%= product.image[0] %>" alt="<%= product.name %>" loading="lazy">
                <% } else { %>
                  <div class="no-image">No Image</div>
                <% } %>
              </a>
              <div class="offer-badge">
                <span><%= product.discount %>% OFF</span>
              </div>
            </div>
            
            <div class="product-info">
              <h2 class="product-title">
                <a href="/auth/product/<%= product._id %>"><%= product.name %></a>
              </h2>
              
              <div class="product-price">
                <span class="original-price">₹<%= product.price.toFixed(2) %></span>
                <span class="discounted-price">₹<%= discountedPrice.toFixed(2) %></span>
                <span class="discount-tag"><%= product.discount %>% off</span>
              </div>
              
             
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="container mt-5 mb-5">
      <div class="row justify-content-center">
        <div class="col-md-8 text-center">
          <div class="subscribe-container p-4 rounded" style="background-color: #f8f9fa; border: 1px solid #dee2e6;">
            <h2 class="mb-3">Subscribe to Our Newsletter</h2>
            <p class="text-muted mb-4">Stay updated with our latest toys and exclusive offers!</p>
            <form class="d-flex justify-content-center gap-2">
              <input type="email" class="form-control" style="max-width: 300px;" placeholder="Enter your email address" required>
              <button type="submit" class="btn btn-primary">Subscribe</button>
            </form>
          </div>
        </div>
      </div>
    </section>
    
  </main>

  <%- include('../partials/footer') %>

  <script>
   // Frontend JavaScript
const handleSubscribe = async (event) => {
    event.preventDefault();
    const emailInput = event.target.querySelector('input[type="email"]');
    const email = emailInput.value;

    // Show loading alert
    Swal.fire({
        title: 'Subscribing...',
        html: 'Please wait while we process your subscription',
        allowOutsideClick: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });
    
    try {
        const response = await fetch('/toy/subscribe', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ email })
        });
        
        const data = await response.json();
        
        if (response.ok) {
            // Success alert
            Swal.fire({
                title: 'Welcome to Toy Galaxy! 🎉',
                text: 'Check your email for an exclusive welcome gift!',
                icon: 'success',
                confirmButtonText: 'Thanks!',
                confirmButtonColor: '#4CAF50',
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp'
                }
            });
            emailInput.value = ''; // Clear the input
        } else {
            // Error alert
            Swal.fire({
                title: 'Oops...',
                text: data.message || 'Something went wrong!',
                icon: 'error',
                confirmButtonText: 'Try Again',
                confirmButtonColor: '#d33'
            });
        }
    } catch (error) {
        console.error('Error:', error);
        // Network error alert
        Swal.fire({
            title: 'Connection Error',
            text: 'Please check your internet connection and try again.',
            icon: 'error',
            confirmButtonText: 'OK',
            confirmButtonColor: '#d33'
        });
    }
};

// Event listener for the form
document.querySelector('.subscribe-container form')
    .addEventListener('submit', handleSubscribe);

// Input validation with sweet alert
document.querySelector('input[type="email"]').addEventListener('invalid', (event) => {
    event.preventDefault();
    Swal.fire({
        title: 'Invalid Email',
        text: 'Please enter a valid email address',
        icon: 'warning',
        confirmButtonText: 'OK',
        confirmButtonColor: '#f8bb86'
    });
});
  </script>
</body>
</html>