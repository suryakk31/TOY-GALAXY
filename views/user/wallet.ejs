<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wallet</title>
  <link rel="stylesheet" href="/css/user/wallet.css">
  <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/header') %>

<div class="main-container">
    <%- include('../partials/sidebar', { currentPath: currentPath }) %>
    
    <div class="content-area">
        <div class="wallet-content">
            <h2>Wallet</h2>
            
            <div class="wallet-balance">
                <div class="wallet-card">
                    <div class="wallet-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
                            <line x1="6" y1="12" x2="6" y2="12"></line>
                            <line x1="10" y1="12" x2="10" y2="12"></line>
                        </svg>
                    </div>
                    <div class="wallet-info">
                        <h3>Toy galaxy Wallet</h3>
                        <p class="balance">Current Balance: ₹<%= walletBalance.toFixed(2) %></p>
                    </div>
                </div>
                
                <button type="button" id="add-amount-btn" class="btn">Add Amount</button>
            </div>

            <div class="transaction-history">
                <h3>Transaction History</h3>
                <% if (transactions && transactions.length > 0) { %>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% transactions.forEach(function(transaction) { %>
                                <tr>
                                    <td><%= transaction.timestamp.toLocaleDateString() %></td>
                                    <td>₹<%= transaction.amount.toFixed(2) %></td>
                                    <td><%= transaction.type %></td>
                                    <td><%= transaction.description || 'N/A' %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                    <% if (pagination.totalPages > 1) { %>
                      <div class="pagination">
                          <% if (pagination.hasPrevPage) { %>
                              <a href="/auth/wallet?page=<%= pagination.prevPage %>" class="page-link">Previous</a>
                          <% } %>
                  
                          <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                              <a href="/auth/wallet?page=<%= i %>" 
                                 class="page-link <%= i === pagination.currentPage ? 'active' : '' %>">
                                  <%= i %>
                              </a>
                          <% } %>
                  
                          <% if (pagination.hasNextPage) { %>
                              <a href="/auth/wallet?page=<%= pagination.nextPage %>" class="page-link">Next</a>
                          <% } %>
                      </div>
                  <% } %>
                <% } else { %>
                    <p>No transactions yet.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<div class="modal fade" id="addAmountModal" tabindex="-1" aria-labelledby="addAmountModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addAmountModalLabel">Add Amount to Wallet</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <input type="number" id="amountInput" class="form-control" placeholder="Enter amount">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" onclick="addAmountToWallet()">Add to Wallet</button>
      </div>
    </div>
  </div>
</div>





<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>


<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Select the Add Amount button
    const addAmountBtn = document.getElementById('add-amount-btn');
    
    // Add click event listener to open the modal
    if (addAmountBtn) {
      addAmountBtn.addEventListener('click', openAddAmountModal);
    }
  });
  
  function openAddAmountModal() {
    // Check if Bootstrap Modal is available
    if (bootstrap && bootstrap.Modal) {
      // Create modal instance
      var addAmountModal = new bootstrap.Modal(document.getElementById('addAmountModal'), {
        keyboard: false
      });
      
      // Show the modal
      addAmountModal.show();
    } else {
      // Fallback method if Bootstrap Modal is not loaded
      console.error('Bootstrap Modal is not available');
      Swal.fire('Error', 'Modal could not be opened. Please refresh the page.', 'error');
    }
  }
  
  function addAmountToWallet() {
    var amount = document.getElementById('amountInput').value;
    if (!amount || amount <= 0) {
      Swal.fire('Error', 'Please enter a valid amount', 'error');
      return;
    }
  
    fetch('/create-razorpay-order', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ amount: amount * 100 }) 
    })
    .then(response => response.json())
    .then(order => {
      var options = {
        "key": order.key_id,
        "amount": order.amount,
        "currency": "INR",
        "name": "Toy galaxy",
        "description": "Add money to wallet",
        "order_id": order.id,
        "handler": function (response) {
          fetch('/update-wallet', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_order_id: response.razorpay_order_id,
              razorpay_signature: response.razorpay_signature,
              amount: amount
            })
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              Swal.fire('Success', 'Amount added to wallet successfully', 'success')
              .then(() => {
                location.reload();
              });
            } else {
              Swal.fire('Error', 'Failed to add amount to wallet', 'error');
            }
          });
        },
        "prefill": {
          "name": "<%= userDatabase.firstName %> <%= userDatabase.lastName %>",
          "email": "<%= userDatabase.email %>",
          "contact": "<%= userDatabase.phoneNumber %>"
        },
        "theme": {
          "color": "#8A2BE2"
        }
      };
      var rzp = new Razorpay(options);
      rzp.open();
    })
    .catch(error => {
      console.error('Error:', error);
      Swal.fire('Error', 'An error occurred. Please try again.', 'error');
    });
  }
  </script>



  
  
</body>
</html>






  


