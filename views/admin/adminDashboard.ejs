<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/admin/admin.css">
  <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
  <title> Admin Dashboard</title>

 
</head>
<body>
  <header>
    <div class="top-nav">
      <div class="logo">
        <h1>TOY GALAXY</h1>
      </div>
     
      <div class="profile-logout">
        <a href="/admin/logout" class="logout-btn">Logout</a>
      </div>
    </div>
  </header> 
  
  <nav>
    <ul>
      <li><a href="/admin/adminDashboard" class="active"><i class='bx bx-home'></i> Dashboard</a></li>
      <li><a href="/admin/userManagement"><i class='bx bx-user'></i> User Management</a></li>
      <li><a href="/admin/category"><i class='bx bx-category'></i> Category</a></li>
      <li><a href="/admin/products"><i class='bx bx-box'></i> Products</a></li>
      <li><a href="/admin/orders"><i class='bx bx-cart'></i> Orders</a></li>
      <li><a href="/admin/coupon"><i class='bx bx-gift'></i> coupon</a></li>
      <li><a href="/admin/sales-report"><i class='bx bx-line-chart'></i> Sales Report</a></li>
      <li><a href="/banner"><i class='bx bx-image'></i> Banner</a></li>
      <li><a href="/chat"><i class='bx bx-chat'></i> Chat</a></li>
      <li><a href="/analytics"><i class='bx bx-bar-chart-alt-2'></i> Analytics</a></li>
      <li><a href="/notifications"><i class='bx bx-bell'></i> Notifications</a></li>
      <li><a href="/settings"><i class='bx bx-cog'></i> Settings</a></li>
    </ul>
  </nav>


  <main class="dashboard-content">
    <h2>Admin Dashboard</h2>
    
    <div class="dashboard-grid">
      <div class="card">
        <h3>Total Sales</h3>
        <p class="big-number">$<%= totalSales.toFixed(2) %></p>
      </div>
      <div class="card">
        <h3>Total Orders</h3>
        <p class="big-number"><%= totalOrders %></p>
      </div>
      <div class="card">
        <h3>Total Users</h3>
        <p class="big-number"><%= totalUsers %></p>
      </div>
      <div class="card">
        <h3>Total Products</h3>
        <p class="big-number"><%= totalProducts %></p>
      </div>
    </div>


    
  
    <div class="chart-container">
      <div class="chart">
        <h3>Sales Chart</h3>
        <select id="salesChartFilter">
          <option value="daily">Daily</option>
          <option value="weekly">Weekly</option>
          <option value="monthly" selected>Monthly</option>
          <option value="yearly">Yearly</option>
        </select>
        <canvas id="salesChart"></canvas>
      </div>
      <div class="chars">
        <h3>Category Distribution</h3>
        <canvas id="categoryChart"></canvas>
      </div>
    </div>
  
    <div class="order-status-grid">
      <div class="cards pending">
        <h3>Pending Orders</h3>
        <p class="big-numbers"><%= orderItemStatusCounts.pending || 0 %></p>
      </div>
     
      <div class="cards delivered">
        <h3>Delivered Orders</h3>
        <p class="big-numbers"><%= orderItemStatusCounts.delivered || 0 %></p>
      </div>
      <div class="cards returned">
        <h3>Returned Orders</h3>
        <p class="big-numbers"><%= orderItemStatusCounts.returned || 0 %></p>
      </div>
      <div class="cards cancelled">
        <h3>Cancelled Orders</h3>
        <p class="big-numbers"><%= orderItemStatusCounts.cancelled || 0 %></p>
      </div>
    </div>


 

  <!-- New Order Status Chart -->
  <div class="charts-container">
    <div class="charts">
      <h3>Order Status Distribution</h3>
      <canvas id="orderStatusChart"></canvas>
    </div>
  </div>

  
    <div class="table-container">
      <h3>Top 10 Best Selling Products</h3>
      <table>
        <thead>
          <tr>
            <th>Rank</th>
            <th>Product Name</th>
            <th>Sales</th>
            <th>Revenue</th>
          </tr>
        </thead>
        <tbody>
          <% topProducts.slice(0, 10).forEach((product, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= product.name %></td>
              <td><%= product.sales %></td>
              <td>$<%= product.revenue.toFixed(2) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="table-container">
      <h3>Top 10 Best Selling Categories</h3>
      <table>
        <thead>
          <tr>
            <th>Rank</th>
            <th>Category Name</th>
            <th>Sales</th>
          </tr>
        </thead>
        <tbody>
          <% topCategories.slice(0, 10).forEach((category, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= category.name %></td>
              <td><%= category.sales %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

   
  </div>
  </main>
  

  <script>
    // Sales Chart
    const salesCtx = document.getElementById('salesChart').getContext('2d');
    let salesChart;

    function updateSalesChart(period) {
      if (salesChart) {
        salesChart.destroy();
      }

      const data = {
        daily: <%- JSON.stringify(dailySales) %>,
        weekly: <%- JSON.stringify(weeklySales) %>,
        monthly: <%- JSON.stringify(monthlySales) %>,
        yearly: <%- JSON.stringify(yearlySales) %>
      };

      salesChart = new Chart(salesCtx, {
        type: 'bar',
        data: {
          labels: data[period].map(item => item._id),
          datasets: [{
            label: 'Sales',
            data: data[period].map(item => item.sales),
            backgroundColor: '#ff5e00'
          }]
        },
        options: {
          responsive: true,
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(value, index, values) {
                  return '$' + value.toLocaleString();
                }
              }
            }
          }
        }
      });
    }

    document.getElementById('salesChartFilter').addEventListener('change', function() {
      updateSalesChart(this.value);
    });

    // Initialize with monthly data
    updateSalesChart('monthly');

    // Category Chart
    const categoryCtx = document.getElementById('categoryChart').getContext('2d');
    new Chart(categoryCtx, {
      type: 'pie',
      data: {
        labels: <%- JSON.stringify(categoryDistribution.map(item => item.name)) %>,
        datasets: [{
          data: <%- JSON.stringify(categoryDistribution.map(item => item.count)) %>,
          backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40']
        }]
      },
      options: {
        responsive: true
      }
    });

    const orderStatusCtx = document.getElementById('orderStatusChart').getContext('2d');
    new Chart(orderStatusCtx, {
      type: 'pie',
      data: {
        labels: ['Pending', 'Delivered', 'Returned', 'Cancelled'],
        datasets: [{
          data: [
            <%= orderItemStatusCounts.pending || 0 %>,
            
            <%= orderItemStatusCounts.delivered || 0 %>,
            <%= orderItemStatusCounts.returned || 0 %>,
            <%= orderItemStatusCounts.cancelled || 0 %>
          ],
          backgroundColor: ['#FFA500', '#4CAF50', '#2196F3', '#F44336', '#9E9E9E']
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'top',
          },
          title: {
            display: true,
            text: 'Order Status Distribution'
          }
        }
      }
    });
  </script>
  
</body>
</html>