<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/admin/editProduct.css">
  <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
  <link href="https://unpkg.com/cropperjs/dist/cropper.css" rel="stylesheet">
  <title>Edit Product</title>
  <style>
    .preview-images {
      display: flex;
      flex-wrap: wrap;
    }
    .preview-images img {
      width: 100px;
      height: 100px;
      margin: 10px;
      object-fit: cover;
    }
    .crop-container {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #fff;
      padding: 20px;
      z-index: 1000;
      border: 1px solid #ccc;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    .crop-container img {
      max-width: 100%;
    }

    .error-message {
      color: #dc3545;
      font-size: 0.875rem;
      margin-top: 0.25rem;
      display: none;
    }
    .error-feedback {
      display: none;
      color: #dc3545;
      font-size: 0.875rem;
      margin-top: 0.25rem;
    }
    .form-group.has-error input,
    .form-group.has-error select,
    .form-group.has-error textarea {
      border-color: #dc3545;
    }
    .form-group.has-error .error-feedback {
      display: block;
    }
    .alert {
      padding: 1rem;
      margin-bottom: 1rem;
      border-radius: 0.25rem;
    }
    .alert-danger {
      background-color: #f8d7da;
      border-color: #f5c6cb;
      color: #721c24;
    }
    .alert-success {
      background-color: #d4edda;
      border-color: #c3e6cb;
      color: #155724;
    }
  </style>
</head>
<body>
  <!-- Header and Navigation -->
  <header>
    <div class="top-nav">
      <div class="logo">
        <h1>TOY GALAXY</h1>
      </div>
     
      <div class="profile-logout">
        <a href="/admin/logout" class="logout-btn">Logout</a>
      </div>
    </div>
  </header>
  <nav>
    <ul>
      <li><a href="/admin/adminDashboard"><i class='bx bx-home'></i> Dashboard</a></li>
      <li><a href="/admin/userManagement"><i class='bx bx-user'></i> User Management</a></li>
      <li><a href="/admin/category"><i class='bx bx-category'></i> Category</a></li>
      <li><a href="/admin/products" class='active'><i class="bx bx-box"></i> Products</a></li>
      <li><a href="/admin/orders"><i class='bx bx-cart'></i> Orders</a></li>
      <li><a href="/admin/coupon"><i class='bx bx-gift'></i> coupon</a></li>
      <li><a href="/admin/sales-report"><i class='bx bx-line-chart'></i> Sales Report</a></li>
   
    </ul>
  </nav>
  <!-- Form Container -->
  <div class="form-container">
  
    <form id="edit-product-form">
      <div class="form-group">
        <label for="name">Product Name:</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          value="<%= product.name %>"
          pattern="[a-zA-Z0-9\s-]+"
          minlength="3"
          maxlength="50"
          required
        >
        <div class="error-feedback" id="name-error"></div>
      </div>

      <div class="form-group">
        <label for="category">Category:</label>
        <select id="category" name="category" required>
          <option value="">Select a category</option>
          <% categories.forEach(category => { %>
            <option value="<%= category._id %>" <%= category._id.equals(product.category) ? 'selected' : '' %>><%= category.name %></option>
          <% }); %>
        </select>
        <div class="error-feedback" id="category-error"></div>
      </div>

      <div class="form-group">
        <label for="price">Price:</label>
        <input 
          type="number" 
          id="price" 
          name="price" 
          value="<%= product.price %>"
          min="0.01"
          step="0.01"
          required
        >
        <div class="error-feedback" id="price-error"></div>
      </div>

      <div class="form-group">
        <label for="description">Description:</label>
        <textarea 
          id="description" 
          name="description"
          minlength="10"
          required
        ><%= product.description %></textarea>
        <div class="error-feedback" id="description-error"></div>
      </div>

      <div class="form-group">
        <label for="stock">Stock:</label>
        <input 
          type="number" 
          id="stock" 
          name="stock" 
          value="<%= product.stock %>"
          min="0"
          required
        >
        <div class="error-feedback" id="stock-error"></div>
      </div>

      <div class="form-group">
        <label for="discount">Discount:</label>
        <input type="number" id="discount" name="discount" value="<%= product.discount %>">
      </div>

      <div class="form-group">
        <label for="image">Image:</label>
        <input type="file" id="image" name="image" multiple accept="image/*">
        <div class="preview-images" id="preview-images">
          <% if (product.image && product.image.length > 0) { %>
            <% product.image.forEach(image => { %>
              <div class="image-wrapper" style="position: relative; display: inline-block; margin: 10px;">
                <img src="<%= image %>" alt="Product Image">
                <button type="button" class="delete-image" style="position: absolute; top: 5px; right: 5px; background-color: red; color: white; border: none; cursor: pointer;">X</button>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <button type="submit" class="submit-btn">Update Product</button>
      <button type="button" class="cancel-btn" onclick="window.location.href='/admin/products'">Cancel</button>
      <div id="error-container"></div>
    
      <% if (errorMessage && errorMessage.length > 0) { %>
        <div class="alert alert-danger">
          <% if (Array.isArray(errorMessage)) { %>
            <ul>
              <% errorMessage.forEach(error => { %>
                <li><%= error %></li>
              <% }); %>
            </ul>
          <% } else { %>
            <%= errorMessage %>
          <% } %>
        </div>
      <% } %>
  
      <% if (successMessage && successMessage.length > 0) { %>
        <div class="alert alert-success">
          <%= successMessage %>
        </div>
      <% } %>
    </form>

  </div>
  <!-- Crop Container -->
  <div class="crop-container" id="crop-container">
    <img id="crop-image" src="" alt="Crop Image">
    <button id="crop-btn">Crop</button>
    <button id="cancel-crop-btn">Cancel</button>
  </div>
  <!-- Cropper.js Script -->
  <script src="https://unpkg.com/cropperjs"></script>
  <script>
    let cropper;
    let currentFile;
    const imageInput = document.getElementById('image');
    const previewContainer = document.getElementById('preview-images');
    const cropContainer = document.getElementById('crop-container');
    const cropImage = document.getElementById('crop-image');
    const cropBtn = document.getElementById('crop-btn');
    const cancelCropBtn = document.getElementById('cancel-crop-btn');
    const deletedImages = new Set(); // Track deleted images

    // Initialize Cropper on the selected image
    function initCropper(imageSrc, file, previewImage) {
        cropImage.src = imageSrc;
        cropContainer.style.display = 'block';

        if (cropper) cropper.destroy();

        cropper = new Cropper(cropImage, {
            aspectRatio: 1,
            viewMode: 1,
        });

        currentFile = file;

        cropBtn.onclick = () => {
            const canvas = cropper.getCroppedCanvas();
            canvas.toBlob(blob => {
                const imgUrl = URL.createObjectURL(blob);
                previewImage.src = imgUrl;

                cropper.destroy();
                cropContainer.style.display = 'none';

                const croppedFile = new File([blob], currentFile.name, { type: currentFile.type });
                updateFileList(croppedFile);
            });
        };
    }

    // Update the file input with the cropped file
    function updateFileList(croppedFile) {
        const dataTransfer = new DataTransfer();
        Array.from(imageInput.files).forEach(file => {
            if (file !== currentFile) dataTransfer.items.add(file);
        });
        dataTransfer.items.add(croppedFile);
        imageInput.files = dataTransfer.files;
    }

    // Handle file input change
    imageInput.addEventListener('change', function(event) {
        const files = Array.from(event.target.files);
        files.forEach(file => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.style.cursor = 'pointer';

                const wrapper = document.createElement('div');
                wrapper.className = 'image-wrapper';
                wrapper.style.position = 'relative';
                wrapper.style.display = 'inline-block';
                wrapper.style.margin = '10px';

                img.addEventListener('click', () => initCropper(e.target.result, file, img));
                wrapper.appendChild(img);

                addDeleteButton(wrapper, img, file);
                previewContainer.appendChild(wrapper);
            };
            reader.readAsDataURL(file);
        });
    });

    // Add delete button to the image wrapper
    function addDeleteButton(wrapper, img, file) {
        const deleteBtn = document.createElement('button');
        deleteBtn.textContent = 'X';
        deleteBtn.className = 'delete-image';
        deleteBtn.style = `
            position: absolute;
            top: 5px;
            right: 5px;
            background-color: red;
            color: white;
            border: none;
            cursor: pointer;
        `;

        deleteBtn.onclick = (e) => {
            e.preventDefault();
            wrapper.remove();
            if (file) {
                removeFileFromInput(file);
            } else {
              const imageUrl = img.src;
              deletedImages.add(imageUrl);
              updateDeletedImagesInput();

            }
        };

        wrapper.appendChild(deleteBtn);
    }

    // Update the deleted images hidden input
    function updateDeletedImagesInput() {
        let hiddenInput = document.getElementById('deleted-images');
        if (!hiddenInput) {
            hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.id = 'deleted-images';
            hiddenInput.name = 'deletedImages';
            document.getElementById('edit-product-form').appendChild(hiddenInput);
        }
        hiddenInput.value = JSON.stringify(Array.from(deletedImages));
    }

    // Remove a specific file from the file input
    function removeFileFromInput(fileToRemove) {
        const dataTransfer = new DataTransfer();
        Array.from(imageInput.files).forEach(file => {
            if (file !== fileToRemove) {
                dataTransfer.items.add(file);
            }
        });
        imageInput.files = dataTransfer.files;
    }

    // Initialize delete buttons for existing images
    document.addEventListener('DOMContentLoaded', () => {
        const existingImages = document.querySelectorAll('.image-wrapper');
        existingImages.forEach(wrapper => {
            const img = wrapper.querySelector('img');
            const deleteBtn = wrapper.querySelector('.delete-image');
            if (deleteBtn) {
                deleteBtn.onclick = (e) => {
                    e.preventDefault();
                    wrapper.remove();   
                    const imageUrl = img.getAttribute('src');
                    deletedImages.add(imageUrl);
                    updateDeletedImagesInput();
                };
            }
        });
    });

    // Handle cancel crop button click
    cancelCropBtn.addEventListener('click', () => {
        if (cropper) cropper.destroy();
        cropContainer.style.display = 'none';
    });

    // Handle form submission with error handling for deleted images
    document.getElementById('edit-product-form').addEventListener('submit', async function(event) {
        event.preventDefault();

        clearPreviousErrors();

        const formData = new FormData(this);
        const productId = '<%= product._id %>';

        // Add deleted images to formData if any
        if (deletedImages.size > 0) {
            formData.set('deletedImages', JSON.stringify(Array.from(deletedImages)));
        }

        try {
            const response = await fetch(`/admin/products/edit/${productId}`, {
                method: 'PUT',
                body: formData,
            });

            const result = await response.json();
            if (response.ok && result.success) {
                window.location.href = '/admin/products';
            } else {
                displayErrors(result);
            }
        } catch (error) {
            console.error('Error:', error);
            displayErrorMessage('An error occurred while updating the product. Please try again.');
        }
    });

    // Clear previous errors from the form
    function clearPreviousErrors() {
        document.querySelectorAll('.error-feedback').forEach(el => el.textContent = '');
        document.querySelectorAll('.form-group').forEach(el => el.classList.remove('has-error'));
        document.getElementById('error-container').innerHTML = '';
    }

    // Display errors in the form
    function displayErrors(result) {
        if (result.errors && Array.isArray(result.errors)) {
            const errorContainer = document.getElementById('error-container');
            errorContainer.innerHTML = `
                <div class="alert alert-danger">
                    <ul>${result.errors.map(error => `<li>${error}</li>`).join('')}</ul>
                </div>
            `;
            highlightErrorFields(result.errors);
        } else {
            displayErrorMessage(result.message || 'An error occurred while updating the product.');
        }
    }

    // Highlight fields with errors
    function highlightErrorFields(errors) {
        errors.forEach(error => {
            if (error.includes('name')) markFieldAsError('name');
            if (error.includes('price')) markFieldAsError('price');
            if (error.includes('stock')) markFieldAsError('stock');
            if (error.includes('description')) markFieldAsError('description');
            if (error.includes('category')) markFieldAsError('category');
        });
    }

    function markFieldAsError(fieldId) {
        document.getElementById(`${fieldId}-error`).textContent = error;
        document.getElementById(fieldId).parentElement.classList.add('has-error');
    }

    function displayErrorMessage(message) {
        document.getElementById('error-container').innerHTML = `
            <div class="alert alert-danger">${message}</div>
        `;
    }
</script>

    

</body>
</html>
