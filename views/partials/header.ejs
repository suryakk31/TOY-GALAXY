<link rel="stylesheet" href="/css/partials/nav_foot.css">

<div class="nav-overlay"></div>

<nav class="navbar">
  <div class="logos">
      <i class='bx bxs-planet rotating-planet'></i>
      <h1 >Toy Galaxy</h1>
  </div>
  <div class="search-container">
    <form action="/shop" method="get" id="searchForm">
        <!-- Preserve existing filter values -->
        <input type="hidden" name="page" value="1">
        <input type="hidden" name="categories" id="categoriesInput">
        <input type="hidden" name="price" id="priceInput">
        <input type="hidden" name="sort" id="sortInput">
        
        <input type="text" 
               placeholder="Explore toys..." 
               name="search" 
               id="searchInput" 
               autocomplete="off">
        <button type="button" class="close-search" id="closeSearch">
            <i class='bx bx-x'></i>
        </button>
        <button type="submit" class="search-button">
            <i class='bx bx-search-alt-2'></i>
        </button>
    </form>
</div>
  <ul class="nav-menu">
      <li class="nav-item">
          <a href="<%= isLoggedIn ? '/auth/homepage' : '/' %>" class="nav-link"><i class='bx bxs-home-alt-2'></i> Home</a>
      </li>
      <li class="nav-item dropdown">
          <a href="#" class="nav-link"><i class='bx bxs-category-alt'></i> Categories <i class='bx bx-chevron-down'></i></a>
          <div class="dropdown-content">
              <ul class="dropdown-menu">
                <% categories.forEach(category => { %>
                  <li><a href="/shop?category=<%= category._id %>"><%= category.name %></a></li
                <% }) %>
              </ul>
          </div>
      </li>
      <li class="nav-item">
          <a href="<%= isLoggedIn ? '/shop' : '/shop' %>" class="nav-link"><i class='bx bxs-store-alt'></i> Shop</a>
      </li>
      <li class="nav-item">
          <a href="<%= isLoggedIn ? '/funZone' : '/funZone' %>" class="nav-link"><i class='bx bxs-game'></i> Fun Zone</a>
      </li>
      <li class="nav-item">
          <a href="<%= isLoggedIn ? '/auth/cart' : '/cart' %>" class="nav-link"><i class="bx bxs-cart-add"></i> Cart</a>
      </li>
      <li class="nav-item user-dropdown">
        <a href="javascript:void(0);" class="nav-link" id="user-icon"><i class="bx bxs-rocket"></i> My Space <i class='bx bx-chevron-down'></i></a>
        <% if (isLoggedIn && userDatabase) { %>
          <div class="user-dropdown-content" id="user-info">
            <a href="/auth/profile"><i class='bx bxs-astronaut'></i> Hello, <%= userDatabase.firstName %></a>
            <a href="/auth/logout" id="logout-button"><i class='bx bxs-exit'></i> Log out</a>
          </div>
        <% } else { %>
          <div class="user-dropdown-content">
            <a href="/auth/login"><i class='bx bxs-meteor'></i> Launch</a>
           
          </div>
        <% } %>
    </li>
  </ul>

  <div class="hamburger">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
  </div>
</nav>





<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<script>
   
 
document.addEventListener('DOMContentLoaded', () => {
  const hamburger = document.querySelector('.hamburger');
  const navMenu = document.querySelector('.nav-menu');
  const navOverlay = document.querySelector('.nav-overlay');
  const dropdowns = document.querySelectorAll(".dropdown, .user-dropdown");
  

  hamburger.addEventListener('click', () => {
    hamburger.classList.toggle('active');
    navMenu.classList.toggle('active');
    navOverlay.classList.toggle('active');
  });


  navOverlay.addEventListener('click', () => {
    hamburger.classList.remove('active');
    navMenu.classList.remove('active');
    navOverlay.classList.remove('active');
  });


  document.querySelectorAll(".nav-link:not(.dropdown .nav-link):not(.user-dropdown .nav-link)").forEach(n => n.addEventListener("click", () => {
    hamburger.classList.remove("active");
    navMenu.classList.remove("active");
    navOverlay.classList.remove('active');
  }));


  dropdowns.forEach(dropdown => {
    const link = dropdown.querySelector('.nav-link');
    const content = dropdown.querySelector('.dropdown-content, .user-dropdown-content');
    
    link.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropdown.classList.toggle("active");
      
      
      dropdowns.forEach(otherDropdown => {
        if (otherDropdown !== dropdown && otherDropdown.classList.contains("active")) {
          otherDropdown.classList.remove("active");
        }
      });
    });
    

    content.addEventListener("click", (e) => {
      e.stopPropagation();
    });
  });


  document.addEventListener("click", (e) => {
    if (!navMenu.contains(e.target) && !hamburger.contains(e.target)) {
      dropdowns.forEach(dropdown => {
        dropdown.classList.remove("active");
      });
    }
  });
});


document.getElementById('user-icon').addEventListener('click', function(event) {
  <% if (isLoggedIn) { %>
    event.preventDefault();
    var userInfo = document.getElementById('user-info');
    if (userInfo.style.display === 'none' || userInfo.style.display === '') {
      userInfo.style.display = 'block';
    } else {
      userInfo.style.display = 'none';
    }
  <% } %>
});

document.getElementById('logout-button').addEventListener('click', function(event) {
  event.preventDefault();
  Swal.fire({
    title: 'Are you sure you want to logout?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes, logout',
    cancelButtonText: 'Cancel'
  }).then((result) => {
    if (result.isConfirmed) {
      window.location.href = '/auth/logout';
    }
  });
});






</script>
  


<script>
document.addEventListener('DOMContentLoaded', () => {
    const searchForm = document.getElementById('searchForm');
    const searchInput = document.getElementById('searchInput');
    const closeSearch = document.getElementById('closeSearch');
    const categoriesInput = document.getElementById('categoriesInput');
    const priceInput = document.getElementById('priceInput');
    const sortInput = document.getElementById('sortInput');

    // Function to get current URL parameters
    function getCurrentFilters() {
        const urlParams = new URLSearchParams(window.location.search);
        return {
            categories: urlParams.get('categories') || '',
            price: urlParams.get('price') || '',
            sort: urlParams.get('sort') || ''
        };
    }

    // Set initial values for filter inputs
    function setFilterInputs() {
        const currentFilters = getCurrentFilters();
        categoriesInput.value = currentFilters.categories;
        priceInput.value = currentFilters.price;
        sortInput.value = currentFilters.sort;
    }

    // Function to redirect to shop with current filters
    function redirectToShop(includeSearch = false) {
        const currentFilters = getCurrentFilters();
        const params = new URLSearchParams();

        // Add non-empty filters
        if (currentFilters.categories) params.append('categories', currentFilters.categories);
        if (currentFilters.price) params.append('price', currentFilters.price);
        if (currentFilters.sort) params.append('sort', currentFilters.sort);

        // Add search term if requested and not empty
        if (includeSearch) {
            const searchTerm = searchInput.value.trim();
            if (searchTerm) {
                params.append('search', searchTerm);
            }
        }

        // Reset to page 1
        params.append('page', '1');

        // Navigate to filtered URL
        window.location.href = `/shop?${params.toString()}`;
    }

    // Validate search input to allow only alphabets with controlled spaces
    searchInput.addEventListener('input', (e) => {
        // Get the current cursor position
        const cursorPosition = e.target.selectionStart;
        
        // Remove multiple consecutive spaces and trim
        let value = e.target.value;
        value = value.replace(/\s+/g, ' ').trim();
        
        // Remove any non-alphabet characters (except single spaces)
        const sanitizedValue = value.replace(/[^a-zA-Z\s]/g, '');
        
        // Prevent starting with space
        if (sanitizedValue.startsWith(' ')) {
            value = sanitizedValue.trimStart();
        } else {
            value = sanitizedValue;
        }
        
        // Update input value if it was changed
        if (e.target.value !== value) {
            e.target.value = value;
            // Adjust cursor position if content was modified
            e.target.setSelectionRange(cursorPosition, cursorPosition);
        }

        // Show/hide close button based on sanitized input
        closeSearch.style.display = value ? 'block' : 'none';

        // If the input is empty after backspace, show all products
        if (!value && e.inputType === 'deleteContentBackward') {
            redirectToShop(false);
        }
    });

    // Handle keyboard events for space and backspace
    searchInput.addEventListener('keydown', (e) => {
        // Prevent space at the beginning
        if (e.key === ' ' && e.target.selectionStart === 0) {
            e.preventDefault();
        }
        
        // Prevent multiple consecutive spaces
        if (e.key === ' ' && e.target.value.charAt(e.target.selectionStart - 1) === ' ') {
            e.preventDefault();
        }
    });

    // Handle form submission
    searchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const searchTerm = searchInput.value.trim();
        
        // Validate search term contains only alphabets and single spaces
        if (!/^[a-zA-Z]+(?:\s[a-zA-Z]+)*$/.test(searchTerm)) {
            alert('Please enter only alphabetical characters with single spaces between words');
            return;
        }

        // Remove empty parameters
        const formData = new FormData(searchForm);
        const params = new URLSearchParams();

        for (const [key, value] of formData.entries()) {
            if (value) {
                params.append(key, value);
            }
        }

        // Navigate to the filtered URL
        window.location.href = `/shop?${params.toString()}`;
    });

    // Reset search while maintaining other filters
    closeSearch.addEventListener('click', () => {
        searchInput.value = '';
        closeSearch.style.display = 'none';
        redirectToShop(false);
    });

    // Initialize the search container
    (() => {
        setFilterInputs();
        const urlParams = new URLSearchParams(window.location.search);
        const searchParam = urlParams.get('search');
        if (searchParam) {
            // Validate and sanitize the search parameter
            const sanitizedSearch = searchParam
                .replace(/[^a-zA-Z\s]/g, '')
                .replace(/\s+/g, ' ')
                .trim();
            searchInput.value = sanitizedSearch;
            closeSearch.style.display = sanitizedSearch ? 'block' : 'none';
        }
    })();
});
</script>